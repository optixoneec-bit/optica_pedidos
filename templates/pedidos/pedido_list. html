<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Óptica Pedidos</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min. css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="/static/css/star-admin. css" rel="stylesheet">
</head>
<body>
    <div class="container- xxl px-0">
        {% if user.is_authenticated %}
        <nav id="sidebar" class="sidebar">
            <div class="d-flex flex-column h-100">
                <div class="sidebar-header">
                    <a href="{% url 'dashboard' %}" class="sidebar-brand">
                        <i class="bi bi-eyedropper"></i>
                        <span>Óptica</span>
                    </a>
                </div>
                
                <ul class="nav flex- column">
                    <li class="nav-item">
                        <a href="{% url 'dashboard' %}" class="nav- link">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a href="{% url 'pedido_list' %}" class="nav-link">Pedidos</a>
                    </li>
                </ul>
                
                <div class="mt-auto sidebar- footer">
                    <div class="user-info">
                        <div class="user-avatar"><i class="bi bi- person-circle"></i></div>
                        <div class="user-details">
                            <span class="user- name">{{ user.username }}</span>
                            <span class="user-role">{{ user.rol }}</span>
                        </div>
                    </div>
                    <a href="{% url 'logout' %}" class="nav-link text-danger">Salir</a>
                </div>
            </div>
        </nav>
        {% endif %}
        
        <main class="main- content" id="main- content">
            {% if user.is_authenticated %}
            <nav class="top- navbar">
                <button class="btn btn-toggle" id="btn- toggle"><i class="bi bi-list"></i></button>
            </nav>
            {% endif %}
            
            <div class="page- content">
                {% if messages %}
                {% for message in messages %}
                <div class="alert alert-{{ message.tags }}">{{ message }}</div>
                {% endfor %}
                {% endif %}
                
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/ bootstrap.bundle.min. js"></script>
    <script src="/static/js/app. js"></script>
    {% block extra_js %}{% endblock %}
</body>
</html>